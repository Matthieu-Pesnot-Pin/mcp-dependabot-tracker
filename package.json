{
  "name": "@imenam/mcp-dependabot-tracker",
  "version": "1.0.24",
  "description": "Server and web GUI that track the Dependabot alerts of GitHub repositories and fix their npm vulnerabilities in a temporary clone: npm audit, audit fix, fixes by Claude, then a branch and a pull request. An MCP mode lets agents drive the server.",
  "main": "dist/src/index.js",
  "scripts": {
    "test": "node --test \"dist/test/*.test.js\"",
    "build:backend": "tsc",
    "build:gui": "cd gui && npm ci && npm run build",
    "build": "npm run build:backend && npm run build:gui",
    "start": "node dist/src/index.js serve",
    "prepublishOnly": "npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependabot",
    "npm-audit",
    "security",
    "github"
  ],
  "type": "module",
  "author": "Imena",
  "license": "ISC",
  "bin": {
    "mcp-dependabot-tracker": "dist/src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "dist/shared",
    "gui/dist",
    "README.md"
  ],
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.316",
    "@hono/node-server": "^2.1.5",
    "@imenam/mcp-gui-interface": "^1.0.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.23",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matthieu-Pesnot-Pin/mcp-dependabot-tracker.git"
  },
  "homepage": "https://github.com/Matthieu-Pesnot-Pin/mcp-dependabot-tracker#readme",
  "bugs": {
    "url": "https://github.com/Matthieu-Pesnot-Pin/mcp-dependabot-tracker/issues"
  }
}
